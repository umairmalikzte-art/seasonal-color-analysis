  "seasons": [
    { "slug": "light-spring", "name": "Light Spring", "family": "spring", "warmth": 0.4, "depth": -0.8, "chroma": 0.3, "contrast": -0.4, "alt_names": "", "neighbors": "light-summer,true-spring", "description": "Light, warm and gently clear. Light Spring colors look like a bright spring morning: soft peach, buttercup yellow, aqua and periwinkle." },
    { "slug": "true-spring", "name": "True Spring", "family": "spring", "warmth": 0.9, "depth": -0.2, "chroma": 0.6, "contrast": 0.0, "alt_names": "Warm Spring", "neighbors": "true-autumn,light-spring", "description": "The warmest Spring. True Spring colors are golden, fresh and clear, like coral, daffodil yellow, kelly green and turquoise." },
    { "slug": "bright-spring", "name": "Bright Spring", "family": "spring", "warmth": 0.4, "depth": -0.1, "chroma": 0.9, "contrast": 0.6, "alt_names": "Clear Spring", "neighbors": "bright-winter,true-spring", "description": "Clear, saturated and slightly warm. Bright Spring colors are vivid and lively, like hot coral, emerald, bright turquoise and clear royal blue." },
    { "slug": "light-summer", "name": "Light Summer", "family": "summer", "warmth": -0.4, "depth": -0.8, "chroma": -0.2, "contrast": -0.5, "alt_names": "", "neighbors": "light-spring,true-summer", "description": "Light, cool and soft. Light Summer colors are airy pastels with a cool cast, like powder blue, lavender, powder pink and aqua mist." },
    { "slug": "true-summer", "name": "True Summer", "family": "summer", "warmth": -0.9, "depth": -0.2, "chroma": -0.4, "contrast": -0.2, "alt_names": "Cool Summer", "neighbors": "true-winter,soft-summer", "description": "The coolest Summer. True Summer colors are cool, medium and gently muted, like raspberry, periwinkle, cadet blue and plum." },
    { "slug": "soft-summer", "name": "Soft Summer", "family": "summer", "warmth": -0.4, "depth": 0.0, "chroma": -0.9, "contrast": -0.4, "alt_names": "", "neighbors": "soft-autumn,true-summer", "description": "Muted, cool-neutral and medium. Soft Summer colors are smoky and blended, like dusty rose, slate blue, gray sage and mauve." },
    { "slug": "soft-autumn", "name": "Soft Autumn", "family": "autumn", "warmth": 0.4, "depth": 0.0, "chroma": -0.9, "contrast": -0.4, "alt_names": "", "neighbors": "soft-summer,true-autumn", "description": "Muted, warm-neutral and medium. Soft Autumn colors are earthy and gentle, like sage, terracotta, soft teal and golden wheat." },
    { "slug": "true-autumn", "name": "True Autumn", "family": "autumn", "warmth": 0.9, "depth": 0.3, "chroma": -0.4, "contrast": 0.0, "alt_names": "Warm Autumn", "neighbors": "true-spring,deep-autumn", "description": "The warmest Autumn. True Autumn colors are rich, golden and earthy, like rust, pumpkin, mustard, moss and warm teal." },
    { "slug": "deep-autumn", "name": "Deep Autumn", "family": "autumn", "warmth": 0.4, "depth": 0.8, "chroma": -0.2, "contrast": 0.4, "alt_names": "Dark Autumn", "neighbors": "deep-winter,true-autumn", "description": "Deep, warm-neutral and rich. Deep Autumn colors are dark and spicy, like oxblood, deep olive, forest green and deep teal." },
    { "slug": "deep-winter", "name": "Deep Winter", "family": "winter", "warmth": -0.4, "depth": 0.8, "chroma": 0.2, "contrast": 0.7, "alt_names": "Dark Winter", "neighbors": "deep-autumn,true-winter", "description": "Deep, cool-neutral and dramatic. Deep Winter colors are dark jewel tones, like burgundy, sapphire, emerald and deep plum." },
